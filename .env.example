# Docker Compose defaults are provided, so the stack can boot without a .env.
# Copy this file to .env when you want to override them.

DB_NAME=lafarge
DB_USER=lafarge
DB_PASSWORD=lafarge_dev_password
REDIS_PASSWORD=localredis

DJANGO_SECRET_KEY=change-this-for-non-local-use
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Optional: external ERP/sales API used by Sales and commission views.
# Example: https://erp.example.com/api
SALES_API_URL=

# Keep false for local http://localhost. Set true behind HTTPS in production.
COOKIE_SECURE=false
